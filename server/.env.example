PORT=5000

# Set this to your MongoDB Atlas connection string.
# Example: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGO_URI= 
# Leave empty for local file storage during UI-only testing.
# MONGO_URI=

# Authentication settings
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional email reminders. For Gmail, use an app password, not your normal password.
EMAIL_REMINDERS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WorkPulse <your-email@gmail.com>"
